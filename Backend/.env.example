# NyayaSaathi Backend Environment Variables

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/nyayasaathi

# JWT Secret
ACCESS_TOKEN_SECRET=your_secret_key_here_change_in_production

# Server Port
PORT=5001

# CORS Origins - comma-separated list (NO /api suffix, just base URLs)
# For local development:
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# For production (include your deployed frontend URL):
# CORS_ORIGIN=https://nyayasaathi.vercel.app,http://localhost:5173

# Environment
NODE_ENV=development

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI API (for AI features)
OPENAI_API_KEY=your_openai_api_key
