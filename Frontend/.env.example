# NyayaSaathi Frontend Environment Variables

# API URL - MUST include /api suffix
# For local development:
VITE_API_URL=http://localhost:5001/api

# For production (Render deployment):
# VITE_API_URL=https://nyayasaathi-final.onrender.com/api

# Note: Socket.IO will automatically connect to the base URL (without /api)
# The application handles URL normalization internally
